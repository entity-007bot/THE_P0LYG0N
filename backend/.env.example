PORT=3000
DATABASE_PATH=./db/squadflow.sqlite
FRONTEND_URL=http://localhost:5173

# Replace with keys from your Squad sandbox dashboard.
SQUAD_SECRET_KEY=replace_me
SQUAD_PUBLIC_KEY=replace_me
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_CALLBACK_URL=http://localhost:3000/api/squad/redirect

# Optional: set these when your Squad merchant profile has split/transfer rails enabled.
SQUAD_GROWTH_VAULT_SUB_MERCHANT_ID=replace_me
SQUAD_SPLIT_PAYMENT_PATH=/transaction/initiate
SQUAD_TRANSFER_PATH=/payout/transfer
GROWTH_VAULT_PERCENT=5

# Optional identity verification provider. Leave replace_me for local demo verification.
# Supported values: dojah, smile-id
IDENTITY_PROVIDER=dojah
IDENTITY_PROVIDER_API_KEY=replace_me
IDENTITY_PROVIDER_BASE_URL=https://api.dojah.io
DOJAH_APP_ID=replace_me
SMILE_PARTNER_ID=replace_me
